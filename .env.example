# 用法：复制本文件为 .env，按需修改（.env 已被 .gitignore 忽略）
#
# 用途：
#   1. docker compose 做变量替换
#   2. music-upload 通过 spring.config.import 自动加载根目录 .env
#   3. 其他服务从进程环境变量读取；IDE 里单独运行时需要配 Run Configuration

# ---------------- Nacos ----------------
# 必须是 base64 编码，且解码后长度 >= 32 字节。生成命令：openssl rand -hex 16 | base64
NACOS_AUTH_TOKEN=VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg5MTIzNDU2Nzg5MDEyMzQ1Njc4OTA=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# ---------------- Redis ----------------
REDIS_PASSWORD=redis123

# ---------------- RabbitMQ ----------------
RABBITMQ_USER=music
RABBITMQ_PASSWORD=music123

# ---------------- Spring Boot 服务 ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
# 库名不在这里配：项目是拆库设计，每个服务连自己的库（music_auth_db / music_music_db ...），
# 已分别写在各自模块的 application.yml 里，用统一变量反而容易配错

# 至少 32 字节，换了之后所有已签发的 token 会立即失效
JWT_SECRET=music-dreamer-please-change-this-secret-key-32bytes

# ---------------- 服务间内部接口 ----------------
# 保护 /internal/**，所有服务必须配置成同一个值；生产环境务必替换
MUSIC_INTERNAL_TOKEN=music-internal-dev-token

# ---------------- 阿里云 OSS（music-upload） ----------------
# endpoint 必须与 bucket 所在地域一致
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=music-dreamer
# 可选：CDN / 自定义域名
OSS_PUBLIC_BASE_URL=

# ---------------- 上传存储 ----------------
# oss：上传到阿里云；local：落到本地目录，适合没有外网时开发
UPLOAD_STORAGE=oss
UPLOAD_LOCAL_DIR=./uploads
# local 模式下返回给前端的访问前缀（经网关）
UPLOAD_PUBLIC_BASE_URL=/api/upload/files
UPLOAD_OBJECT_PREFIX=music/
